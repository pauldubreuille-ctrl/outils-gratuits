
{
  "$schema": "https://schema.cloudflare.com/wrangler/config-schema.json",
  "name": "outils-gratuits",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outils-gratuits-db",
      "database_id": "9197ba0e-d3ad-4407-b26a-d092ae690d9e"
    }
  ]
}
